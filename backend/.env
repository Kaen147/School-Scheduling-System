# Server Configuration
PORT=5000

# MongoDB Connection
# For local development, use:
MONGODB_URI=mongodb://localhost:27017/schooldb

# For MongoDB Atlas (cloud), use format:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/school-scheduling?retryWrites=true&w=majority

# Alternative MongoDB URL variable (fallback)
URL=mongodb://localhost:27017/schooldb

# Frontend URL (for production CORS)
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a random string for production)
JWT_SECRET=your-secret-key-change-this-in-production

# Node Environment
NODE_ENV=development
